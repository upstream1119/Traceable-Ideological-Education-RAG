{
  "name": "dachuang-light-web-display",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-display-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-display-assets.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run sync:assets && node scripts/verify-display-assets.mjs && vitest run",
    "sync:assets": "node scripts/sync-display-assets.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}